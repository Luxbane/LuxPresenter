# Copies a downloaded third-party dependency into the Portable folder once (a stamp file records the version, so
# rebuilds are fast and an updated dependency is copied again).
#   cmake -DSRC=<folder> -DDST=<folder> -DSTAMP=<text> [-DEXTRA_FILES="a;b"] [-DREMOVE_GLOBS="*.msi"] -P bundle_dependency.cmake
if(NOT EXISTS "${SRC}")
    message(STATUS "bundle: ${SRC} not present, skipped")
    return()
endif()
set(stamp_file "${DST}/.lux-bundled")
if(EXISTS "${stamp_file}")
    file(READ "${stamp_file}" current)
    string(STRIP "${current}" current)
    if(current STREQUAL "${STAMP}")
        return()
    endif()
endif()
message(STATUS "bundle: copying ${SRC} -> ${DST}")
file(REMOVE_RECURSE "${DST}")
file(MAKE_DIRECTORY "${DST}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_directory "${SRC}" "${DST}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    file(REMOVE_RECURSE "${DST}")
    message(FATAL_ERROR "bundle: copy of ${SRC} failed")
endif()
foreach(glob IN LISTS REMOVE_GLOBS)
    file(GLOB doomed "${DST}/${glob}")
    if(doomed)
        file(REMOVE ${doomed})
    endif()
endforeach()
foreach(extra IN LISTS EXTRA_FILES)
    if(EXISTS "${extra}")
        file(COPY "${extra}" DESTINATION "${DST}/program")
    endif()
endforeach()
file(WRITE "${stamp_file}" "${STAMP}\n")
