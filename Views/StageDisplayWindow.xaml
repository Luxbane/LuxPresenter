<Window x:Class="LuxPresenter.Views.StageDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LuxPresenter - Stage Display (Confidence Monitor)"
        Icon="/app_icon.png"
        Width="960" Height="540"
        MinWidth="480" MinHeight="320"
        Background="#000000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Tahoma, sans-serif">

    <Grid Background="#000000">
        <Grid.RowDefinitions>
            <!-- Top Status Bar: Clock, Title, Status Badges -->
            <RowDefinition Height="Auto"/>
            <!-- Optional Stage Alert Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content: Current Slide (Top) and Next Slide (Bottom) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,2" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Current Digital Clock -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Song / Item Title & Section Badge -->
                    <ColumnDefinition Width="*"/>
                    <!-- Status Badges & Controls -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Digital Clock -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🕒 " FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtClock" Text="12:00:00 PM" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Active Item Title -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="TxtItemTitle" Text="Song Title" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center"/>
                    <Border x:Name="BadgeSection" Background="#374151" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCurrentLabel" Text="Verse 1" FontSize="11" FontWeight="Bold" Foreground="#FCD34D"/>
                    </Border>
                </StackPanel>

                <!-- Status Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Blackout Badge -->
                    <Border x:Name="BadgeBlackout" Background="#DC2626" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" Visibility="Collapsed">
                        <TextBlock Text="⬛ BLACKOUT" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Clear Badge -->
                    <Border x:Name="BadgeClear" Background="#D97706" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" Visibility="Collapsed">
                        <TextBlock Text="⚪ CLEAR" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Live Badge -->
                    <Border x:Name="BadgeLive" Background="#16A34A" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock Text="🔴 LIVE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Fullscreen Toggle Button -->
                    <Button x:Name="BtnFullscreen" Content="⛶" Click="OnFullscreenToggleClick" ToolTip="Toggle Fullscreen (F11)" Width="28" Height="26" Background="#1F2937" Foreground="#9CA3AF" BorderThickness="0" FontSize="13" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STAGE ALERT BANNER (Optional message from operator to stage) -->
        <Border x:Name="StageAlertBanner" Grid.Row="1" Background="#DC2626" Padding="14,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠️ STAGE ALERT: " FontSize="14" FontWeight="Bold" Foreground="#FEF08A" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStageAlertMessage" Grid.Column="1" Text="Message to Stage" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="✕" Click="OnDismissAlertClick" Background="Transparent" Foreground="#FCA5A5" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- MAIN STAGE DISPLAY SPLIT VIEW -->
        <Grid Grid.Row="2" Margin="20,12">
            <Grid.RowDefinitions>
                <!-- Upper Section: Current Slide (Active) -->
                <RowDefinition Height="3*" MinHeight="120"/>
                <!-- Splitter Divider -->
                <RowDefinition Height="Auto"/>
                <!-- Lower Section: Next Slide Preview -->
                <RowDefinition Height="2*" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- 1. CURRENT SLIDE SECTION -->
            <Border Grid.Row="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="8" Padding="20,14" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="▶ CURRENT SLIDE" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtCurrentSlideIndex" Text="Slide 1/4" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCurrentSlideText"
                                   Text="Current slide lyrics will appear here"
                                   Foreground="#FDE047"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="900"
                                   Margin="10"/>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- DIVIDER LINE -->
            <Grid Grid.Row="1" Margin="0,2,0,2">
                <Rectangle Height="2" Fill="#334155"/>
            </Grid>

            <!-- 2. NEXT SLIDE PREVIEW SECTION -->
            <Border Grid.Row="2" Background="#0B132B" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="8" Padding="16,10" Margin="0,6,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtNextHeader" Text="⏭ NEXT SLIDE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtNextLabelBadge" Text="[Chorus]" FontSize="11" Foreground="#38BDF8" DockPanel.Dock="Left" Margin="8,0,0,0"/>
                    </DockPanel>

                    <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNextSlideText"
                                   Text="Next slide preview will appear here"
                                   Foreground="#94A3B8"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="900"
                                   Margin="8"/>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
