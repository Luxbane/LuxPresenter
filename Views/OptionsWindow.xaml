<Window x:Class="LuxPresenter.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LuxPresenter.Converters"
        Title="Options" 
        Height="520" Width="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Tahoma"
        FontSize="11">

    <Window.Resources>
        <converters:HexOrImageBrushConverter x:Key="HexOrImageBrushConverter"/>

        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#1D4ED8" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Main Content (Left Sidebar + Right Settings Panel) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Row (Preview Live Output Checkbox + OK / Cancel) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar (150px) -->
                <ColumnDefinition Width="150"/>
                <!-- Divider -->
                <ColumnDefinition Width="12"/>
                <!-- Right Settings -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Categories + Monitor Graphic Preview (Image 7 & 8) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Category Tabs List -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource ListBgBrush}">
                    <ListBox x:Name="CategoryListBox" SelectedIndex="0" BorderThickness="0" ItemContainerStyle="{StaticResource CategoryItemStyle}" SelectionChanged="OnCategorySelectionChanged">
                        <ListBoxItem Content="General"/>
                        <ListBoxItem Content="Songs"/>
                        <ListBoxItem Content="Advanced"/>
                    </ListBox>
                </Border>

                <!-- Monitor Graphic Preview at Bottom Left (Image 7) -->
                <Border Grid.Row="1" VerticalAlignment="Bottom" Margin="0,10,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Monitor Frame -->
                        <Border Width="130" Height="80" Background="#111111" CornerRadius="4" BorderBrush="#333333" BorderThickness="3">
                            <!-- Screen with active slide preview -->
                            <Grid x:Name="MonitorScreenGrid" Background="#001833" ClipToBounds="True">
                                <TextBlock x:Name="TxtMonitorSample"
                                           Text="Lord you are beautiful,&#x0a;I raise my hands to you,&#x0a;No one else can touch&#x0a;my heart like you do." 
                                           FontFamily="Tahoma" 
                                           FontSize="7.5" 
                                           FontWeight="Bold" 
                                           Foreground="White" 
                                           TextAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Margin="4"
                                           LineHeight="9.5">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.9"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <!-- Monitor Stand Stem -->
                        <Rectangle Width="16" Height="14" Fill="#333333" HorizontalAlignment="Center"/>
                        <!-- Monitor Stand Base -->
                        <Ellipse Width="65" Height="10" Fill="#222222" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT SETTINGS PANEL: Container for General, Songs, etc. -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
                <Grid>
                    <!-- 1. GENERAL PANEL (Image 5) -->
                    <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                        <StackPanel>
                            <!-- Header: General -->
                            <TextBlock Text="General" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,12"/>

                                                        <!-- GROUP 0: THEME & APPEARANCE -->
                            <GroupBox Header="Appearance &amp; Theme" FontSize="10" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <RadioButton x:Name="RbLightMode" Content="☀️ Light Mode (Classic)" IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="RbDarkMode" Content="🌙 Dark Mode (Charcoal Gray)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- GROUP 1: MARGINS -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Margins" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Screen Margin % -->
                                        <GroupBox Grid.Column="0" Header="Screen Margin %" FontSize="10" Margin="0,0,4,0">
                                            <Grid Margin="6,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Top" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtMarginTop" Grid.Row="0" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Bottom" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtMarginBottom" Grid.Row="1" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Left" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtMarginLeft" Grid.Row="2" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Right" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtMarginRight" Grid.Row="3" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>
                                            </Grid>
                                        </GroupBox>

                                        <!-- Text Margin % -->
                                        <GroupBox Grid.Column="1" Header="Text Margin %" FontSize="10" Margin="2,0,2,0">
                                            <Grid Margin="6,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Top" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Bottom" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Left" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Right" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="3" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>
                                            </Grid>
                                        </GroupBox>

                                        <!-- Bleed Margin % -->
                                        <GroupBox Grid.Column="2" Header="Bleed Margin %" FontSize="10" Margin="4,0,0,0">
                                            <Grid Margin="6,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Top" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Bottom" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Left" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Right" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="3" Grid.Column="1" Text="0" TextAlignment="Center" Margin="10,1,0,1"/>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- GROUP 2: SELECT OUTPUT MONITOR (Image 5) -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Select Output Monitor" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Monitor Dropdown -->
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Output Monitor" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbMonitors" 
                                                      DisplayMemberPath="DisplayName" 
                                                      Height="24" 
                                                      FontSize="11"/>
                                        </StackPanel>

                                        <!-- Custom Position -->
                                        <GroupBox Grid.Column="1" Header="Custom Position" FontSize="10">
                                            <Grid Margin="4,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="20"/>
                                                    <RowDefinition Height="20"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Left" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="0" TextAlignment="Center" Margin="6,1,0,1"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Top" VerticalAlignment="Center"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="0" TextAlignment="Center" Margin="6,1,0,1"/>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- GROUP 3: STAGE DISPLAY (CONFIDENCE MONITOR) -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Stage Display (Confidence Monitor)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                    <CheckBox x:Name="ChkEnableStageDisplay" Content="Enable Stage Display (Confidence Monitor for stage / singers)" FontSize="11" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Stage Monitor Output" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbStageMonitors" Height="24" FontSize="11"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnTestStageDisplay" Content="Open Preview" Height="24" VerticalAlignment="Bottom" Click="OnTestStageDisplayClick"/>
                                    </Grid>

                                    <!-- Wireless Web Stage Server -->
                                    <Border Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkEnableStageWebServer" Content="Enable Wireless Web Stage Display (for TV browser / iPad / phone)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="Connect any device on the church Wi-Fi to this local URL:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <DockPanel>
                                                <Button x:Name="BtnCopyStageUrl" Content="Copy URL" Width="70" Height="22" DockPanel.Dock="Right" FontSize="10" Click="OnCopyStageUrlClick"/>
                                                <TextBox x:Name="TxtStageUrl" Text="http://127.0.0.1:8080/stage" IsReadOnly="True" FontSize="10.5" Height="22" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. SONGS PANEL (Image 7 & 8) -->
                    <ScrollViewer x:Name="SongsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <!-- Header: Songs -->
                            <TextBlock Text="Songs" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,10"/>

                            <!-- SECTION 1: SONG OPTIONS -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Song Options" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                    <Grid Margin="6,0,0,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="26"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Text Alignment -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Text Alignment" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbSongTextAlign" Grid.Row="0" Grid.Column="1" Height="22">
                                            <ComboBoxItem Content="Left"/>
                                            <ComboBoxItem Content="Center"/>
                                            <ComboBoxItem Content="Right"/>
                                        </ComboBox>

                                        <!-- Vertical Align -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vertical Align" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbSongVerticalAlign" Grid.Row="1" Grid.Column="1" Height="22">
                                            <ComboBoxItem Content="Top"/>
                                            <ComboBoxItem Content="Center"/>
                                            <ComboBoxItem Content="Bottom"/>
                                        </ComboBox>

                                        <!-- Global Song Font Family -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Default Song Font Family" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbSongFontFamily" Grid.Row="2" Grid.Column="1" Height="22">
                                            <ComboBoxItem Content="Arial"/>
                                            <ComboBoxItem Content="Tahoma"/>
                                            <ComboBoxItem Content="Segoe UI"/>
                                            <ComboBoxItem Content="Calibri"/>
                                            <ComboBoxItem Content="Trebuchet MS"/>
                                            <ComboBoxItem Content="Verdana"/>
                                            <ComboBoxItem Content="Arial Black"/>
                                            <ComboBoxItem Content="Times New Roman"/>
                                            <ComboBoxItem Content="Impact"/>
                                        </ComboBox>

                                        <!-- Global Default Font Size -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Default Font Size (pt)" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbSongFontSize" Grid.Row="3" Grid.Column="1" Height="22" IsEditable="True">
                                            <ComboBoxItem Content="9"/>
                                            <ComboBoxItem Content="10"/>
                                            <ComboBoxItem Content="11"/>
                                            <ComboBoxItem Content="12"/>
                                            <ComboBoxItem Content="13"/>
                                            <ComboBoxItem Content="14"/>
                                            <ComboBoxItem Content="15"/>
                                            <ComboBoxItem Content="16"/>
                                            <ComboBoxItem Content="18"/>
                                            <ComboBoxItem Content="20"/>
                                            <ComboBoxItem Content="24"/>
                                            <ComboBoxItem Content="28"/>
                                        </ComboBox>
                                        <CheckBox x:Name="ChkSongFontBold" Grid.Row="3" Grid.Column="2" Content="Bold font" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="True"/>

                                        <!-- Desired Font Height Percentage -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Desired Font Height Percentage" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtSongFontPercent" Grid.Row="4" Grid.Column="1" Text="14" TextAlignment="Center" VerticalContentAlignment="Center" Height="22" Width="60" HorizontalAlignment="Left"/>

                                        <!-- Apply to All Songs in Library -->
                                        <CheckBox x:Name="ChkApplyFontToAllSongs" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Content="Apply font family and size to all existing songs in Library" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: VERSE/CHORUS LABEL OPTIONS -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Verse/Chorus Label Options" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                    <CheckBox x:Name="ChkShowVerseLabels" Content="Show Verse/Chorus Labels" Margin="6,0,0,8" IsChecked="False"/>

                                    <Grid Margin="6,0,0,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Label Location" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbLabelLocation" Grid.Row="0" Grid.Column="1" Height="22">
                                            <ComboBoxItem Content="Top Left"/>
                                            <ComboBoxItem Content="Top Center" IsSelected="True"/>
                                            <ComboBoxItem Content="Top Right"/>
                                            <ComboBoxItem Content="Bottom Left"/>
                                            <ComboBoxItem Content="Bottom Center"/>
                                            <ComboBoxItem Content="Bottom Right"/>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Label Size" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbLabelSize" Grid.Row="1" Grid.Column="1" Height="22">
                                            <ComboBoxItem Content="Small"/>
                                            <ComboBoxItem Content="Normal" IsSelected="True"/>
                                            <ComboBoxItem Content="Large"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="6,2,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkIndentLabel" Grid.Column="0" Content="Indent Label" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Label Font" Width="85" Height="23" HorizontalAlignment="Left" Margin="10,0,0,0" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="6,4,0,0">
                                        <TextBlock Text="Select label color coding for song previews" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Content="Color Coding" Width="85" Height="23" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3: WORD FORMATTING OPTIONS (Image 8) -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Word Formatting Options" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                                    <CheckBox x:Name="ChkAutoWrap" Content="Automatically wrap words if needed" Margin="6,2,0,4" IsChecked="True"/>
                                    <CheckBox x:Name="ChkCapitalizeAll" Content="Capitalize all words (ALL CAPS)" Margin="6,2,0,4" IsChecked="True"/>
                                    <CheckBox x:Name="ChkCapitalizeFirstLine" Content="Capitalize first character on each line" Margin="6,2,0,4" IsChecked="False"/>
                                    <CheckBox x:Name="ChkAutoCapitalizeKeywords" Content="Automatically capitalize first character of these words" Margin="6,2,0,4" IsChecked="False"/>

                                    <TextBox x:Name="TxtKeywords" 
                                             AcceptsReturn="True" 
                                             VerticalScrollBarVisibility="Auto" 
                                             Height="60" 
                                             Width="150" 
                                             HorizontalAlignment="Left" 
                                             Margin="24,4,0,0" 
                                             Text="CHRIST&#x0a;FATHER&#x0a;GOD&#x0a;HE&#x0a;HIS&#x0a;HIM&#x0a;HIMSELF"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: TRANSITIONS (User Requested) -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Transitions (Blend)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="6,0,0,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                            <RowDefinition Height="26"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Song Transition" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbSongTransition" Grid.Row="0" Grid.Column="1" Height="22">
                                            <ComboBoxItem Content="Blend"/>
                                            <ComboBoxItem Content="Cut"/>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Slide Transition" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbSlideTransition" Grid.Row="1" Grid.Column="1" Height="22">
                                            <ComboBoxItem Content="Blend"/>
                                            <ComboBoxItem Content="Cut"/>
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Media Transition (Song ↔ Video)" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbMediaTransition" Grid.Row="2" Grid.Column="1" Height="22">
                                            <ComboBoxItem Content="Blend"/>
                                            <ComboBoxItem Content="Cut"/>
                                        </ComboBox>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Screen (Black/Logo/Clear)" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbScreenTransition" Grid.Row="3" Grid.Column="1" Height="22">
                                            <ComboBoxItem Content="Blend"/>
                                            <ComboBoxItem Content="Cut"/>
                                        </ComboBox>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Transition Speed" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbTransitionDuration" Grid.Row="4" Grid.Column="1" Height="22">
                                            <ComboBoxItem Content="Fast (250 ms)"/>
                                            <ComboBoxItem Content="Normal (500 ms)"/>
                                            <ComboBoxItem Content="Smooth (750 ms)"/>
                                            <ComboBoxItem Content="Slow (1000 ms)"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. ADVANCED PANEL -->
                    <ScrollViewer x:Name="AdvancedPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,16,16">
                            <TextBlock Text="Advanced" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,16"/>

                            <!-- SECTION: VIDEO BACKGROUND ENGINE -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource SurfaceBgBrush}" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Video Background Engine" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Select the playback engine for motion video backgrounds behind lyrics:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                    <Grid Margin="4,0,0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="230"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Playback Engine" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <ComboBox x:Name="CmbVideoBgEngine" Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="MediaElement (Unified Single-Window / Recommended)"/>
                                            <ComboBoxItem Content="libmpv (Dual-Window Legacy)"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM ACTION ROW (Image 7) -->
        <Grid Grid.Row="1">
            <CheckBox x:Name="ChkPreviewLiveOutput"
                      Content="Preview Live Output" 
                      IsChecked="False" 
                      VerticalAlignment="Center" 
                      FontSize="11" 
                      Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Click="OnOkClicked" Width="75" Height="24" Margin="0,0,6,0" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                <Button Content="Cancel" Click="OnCancelClicked" Width="75" Height="24" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
