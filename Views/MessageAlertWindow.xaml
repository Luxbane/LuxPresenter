<Window x:Class="LuxPresenter.Views.MessageAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message Alert" 
        Height="310" Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Tahoma"
        FontSize="11">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Top Controls: Message, Count, and Top Action Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Section Header: Current Running Messages -->
            <RowDefinition Height="Auto"/>
            <!-- Messages List + Side Buttons -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP CONTROLS -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="85"/>
            </Grid.ColumnDefinitions>

            <!-- Inputs (Message + Count) -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <!-- Row 1: Message -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Message" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox x:Name="CmbMessage" Grid.Column="1" IsEditable="True" Height="24" FontSize="11">
                        <ComboBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Delete Selected Preset" Click="OnDeletePresetClicked"/>
                            </ContextMenu>
                        </ComboBox.ContextMenu>
                    </ComboBox>
                    <Button x:Name="BtnDeletePreset" Grid.Column="2" Content="✕" Click="OnDeletePresetClicked" 
                            Width="24" Height="24" Margin="4,0,0,0" ToolTip="Delete selected message from preset list"
                            Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FCA5A5" FontWeight="Bold" Cursor="Hand"/>
                </Grid>

                <!-- Row 2: Count -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Count" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="TxtCount" Text="3" Width="44" Height="22" TextAlignment="Center" VerticalContentAlignment="Center"/>
                        <StackPanel Margin="2,0,0,0">
                            <Button Content="▲" FontSize="7" Width="18" Height="10" Padding="0" Click="OnCountUpClick" Focusable="False" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button Content="▼" FontSize="7" Width="18" Height="10" Padding="0" Margin="0,2,0,0" Click="OnCountDownClick" Focusable="False" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Top Action Buttons (Add, Remove, Hide) -->
            <StackPanel Grid.Column="1">
                <Button Content="Add" Click="OnAddClicked" Height="23" Margin="0,0,0,4" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="Remove" Click="OnRemoveClicked" Height="23" Margin="0,0,0,4" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button x:Name="BtnHide" Content="Hide" Click="OnHideClicked" Height="23" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- SECTION HEADER -->
        <TextBlock Grid.Row="1" Text="Current Running Messages" FontWeight="Bold" Margin="0,4,0,4" Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- MESSAGES LIST + SIDE BUTTONS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="85"/>
            </Grid.ColumnDefinitions>

            <!-- Running Messages ListView -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource ListBgBrush}">
                <ListView x:Name="LvRunningMessages" BorderThickness="0" SelectionMode="Single" Background="{DynamicResource ListBgBrush}" Foreground="{DynamicResource ListItemTextBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Count" Width="55" DisplayMemberBinding="{Binding Count}"/>
                            <GridViewColumn Header="Message" Width="280" DisplayMemberBinding="{Binding Text}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Side Buttons -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Content="Select Priority" IsEnabled="False" Height="23" Margin="0,0,0,4" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="Select Next" IsEnabled="False" Height="23" Margin="0,0,0,16" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="Close" Click="OnCloseClicked" Height="24" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>