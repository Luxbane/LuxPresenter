<Window x:Class="LuxPresenter.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update"
        Icon="/app_icon.png"
        Width="480" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI, Tahoma">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="🚀" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="New Version Available!" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtVersionSub" Text="Current: v1.0.0 → New: v1.0.1" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Changelog / Release Notes -->
        <Border Grid.Row="1" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtChangelog"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Later" 
                        Width="80" Height="28" 
                        DockPanel.Dock="Left"
                        Click="OnCancelClick"
                        Background="{DynamicResource ButtonBgBrush}" 
                        BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                        FontSize="11.5"/>

                <Button Content="Download Update" 
                        Width="140" Height="28" 
                        DockPanel.Dock="Right"
                        Click="OnDownloadClick"
                        Background="#0284C7" 
                        Foreground="White" 
                        BorderBrush="#0369A1" 
                        FontWeight="SemiBold" 
                        FontSize="11.5"
                        IsDefault="True"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
