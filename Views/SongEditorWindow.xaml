<Window x:Class="LuxPresenter.Views.SongEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LuxPresenter.Converters"
        xmlns:components="clr-namespace:LuxPresenter.Views.Components"
        Title="Editor" 
        Height="580" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}">
    <Window.Resources>
        <converters:HexOrImageBrushConverter x:Key="HexOrImageBrushConverter"/>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <!-- 1. Title Input Bar + Top Action Icons -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Typography & Formatting Toolbar (Tahoma, 10, B, I, U, S, O, A, Background) -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Two-Column Work Area: Left Lyrics Editor, Right Slide Preview -->
            <RowDefinition Height="*"/>
            <!-- 4. Bottom Controls: Checkbox & OK / Cancel -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TITLE INPUT BAR -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBgBrush}" Padding="6,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,4">
            <DockPanel>
                <!-- Quick Icons at Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="ℹ️" ToolTip="Song Information" Width="22" Height="22" Margin="2,0" Background="Transparent" BorderThickness="0"/>
                    <Button Content="🖨️" ToolTip="Print" Width="22" Height="22" Margin="2,0" Background="Transparent" BorderThickness="0"/>
                    <Separator Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}"/>
                    <Button Content="✂️" ToolTip="Cut" Width="22" Height="22" Margin="2,0" Background="Transparent" BorderThickness="0"/>
                    <Button Content="📋" ToolTip="Copy" Width="22" Height="22" Margin="2,0" Background="Transparent" BorderThickness="0"/>
                    <Button Content="📄" ToolTip="Paste" Width="22" Height="22" Margin="2,0" Background="Transparent" BorderThickness="0"/>
                    <Separator Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}"/>
                    <Button Content="↩️" ToolTip="Undo" Width="22" Height="22" Margin="2,0" Background="Transparent" BorderThickness="0"/>
                    <Button Content="↪️" ToolTip="Redo" Width="22" Height="22" Margin="2,0" Background="Transparent" BorderThickness="0"/>
                    <Separator Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}"/>
                    <Button Content="🔍" ToolTip="Zoom" Width="22" Height="22" Margin="2,0" Background="Transparent" BorderThickness="0"/>
                </StackPanel>

                <!-- Title Label and Input -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Title" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="11"/>
                    <TextBox x:Name="TxtTitle" Width="320" Height="22" Padding="4,2" FontSize="11" TextChanged="OnLyricsOrTitleChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. FORMATTING TOOLBAR (Matching Image 2: Tahoma, 10, B, I, U, S, O, A, Background ▾) -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}" Padding="6,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
            <DockPanel>
                <TextBlock x:Name="BtnResetAttributes" Text="Reset Attributes" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10" Foreground="#64748B" Cursor="Hand" Margin="8,0,4,0" MouseLeftButtonUp="OnResetAttributesClick"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Font Picker -->
                    <ComboBox x:Name="CmbFontFamily" Width="140" Height="22" FontSize="11" Margin="0,0,4,0" SelectionChanged="OnFormattingChanged">
                        <ComboBoxItem Content="Default (Tahoma)" Tag="Tahoma"/>
                        <ComboBoxItem Content="Arial" Tag="Arial"/>
                        <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
                        <ComboBoxItem Content="Times New Roman" Tag="Times New Roman"/>
                        <ComboBoxItem Content="Trebuchet MS" Tag="Trebuchet MS"/>
                        <ComboBoxItem Content="Verdana" Tag="Verdana"/>
                    </ComboBox>

                    <!-- Size Picker -->
                    <TextBox x:Name="TxtFontSize" Text="13" Width="30" Height="22" FontSize="11" TextAlignment="Center" Margin="0,0,6,0" TextChanged="OnFormattingChanged"/>

                    <!-- Styling buttons: B, I, U, S, O, A -->
                    <ToggleButton x:Name="BtnBold" Content="B" FontWeight="Bold" Width="22" Height="22" Margin="1,0" FontSize="11" IsChecked="True" Click="OnFormattingChanged"/>
                    <ToggleButton x:Name="BtnItalic" Content="I" FontStyle="Italic" Width="22" Height="22" Margin="1,0" FontSize="11" Click="OnFormattingChanged"/>
                    <ToggleButton x:Name="BtnUnderline" Content="U" Width="22" Height="22" Margin="1,0" FontSize="11" Click="OnFormattingChanged"/>
                    <ToggleButton x:Name="BtnShadow" Content="S" Width="22" Height="22" Margin="1,0" FontSize="11" IsChecked="True" ToolTip="Shadow" Click="OnFormattingChanged"/>
                    <ToggleButton x:Name="BtnOutline" Content="O" FontWeight="Bold" Width="22" Height="22" Margin="1,0" FontSize="11" IsChecked="True" ToolTip="Outline Text" Click="OnFormattingChanged"/>
                    <Button x:Name="BtnColor" Content="A" FontWeight="Bold" Foreground="#1E3A8A" Width="22" Height="22" Margin="1,0,8,0" FontSize="11" ToolTip="Font Color"/>

                    <!-- Background Picker -->
                    <ComboBox x:Name="CmbBackground" Width="145" Height="22" FontSize="11" SelectionChanged="OnBackgroundSelectionChanged">
                        <ComboBoxItem Content="Deep Blue Majesty" Tag="#001833" IsSelected="True"/>
                        <ComboBoxItem Content="Midnight Navy" Tag="#0B132B"/>
                        <ComboBoxItem Content="Royal Indigo" Tag="#1A1B41"/>
                        <ComboBoxItem Content="Slate Charcoal" Tag="#1E293B"/>
                        <ComboBoxItem Content="Emerald Dark" Tag="#064E3B"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. TWO-COLUMN WORK AREA (Image 2) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left: Lyrics Text Editor -->
                <ColumnDefinition Width="1.1*"/>
                <!-- Splitter -->
                <ColumnDefinition Width="6"/>
                <!-- Right: Graphical Slide Preview -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Lyrics Text Editor -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource InputBgBrush}">
                <Grid>
                    <TextBox x:Name="TxtLyrics" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" 
                             FontFamily="Tahoma" 
                             FontSize="11" 
                             Padding="8" 
                             BorderThickness="0" 
                             TextChanged="OnLyricsOrTitleChanged"/>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Cursor="SizeWE"/>

            <!-- Right: Real-time Graphical Slide Preview -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource ListBgBrush}" Padding="10">
                <Viewbox Stretch="Uniform">
                    <Border Width="640" Height="360" Background="Black" ClipToBounds="True">
                        <Grid x:Name="SlidePreviewGrid" Background="#001833">
                            <Grid Margin="32,20,32,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Preview Lyrics Text (Large bold font with outline and shadow) -->
                                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly">
                                    <components:OutlinedTextBlock x:Name="TxtPreviewContent"
                                                                  FontFamily="Tahoma"
                                                                  FontSize="40"
                                                                  FontWeight="Bold"
                                                                  Fill="White"
                                                                  Stroke="Black"
                                                                  StrokeThickness="2.5"
                                                                  HasOutline="True"
                                                                  HasShadow="True"
                                                                  TextAlignment="Center"
                                                                  TextWrapping="Wrap"/>
                                </Viewbox>

                                <!-- Footer Author / Copyright -->
                                <TextBlock Grid.Row="1"
                                           x:Name="TxtPreviewFooter"
                                           FontFamily="Tahoma"
                                           FontSize="13"
                                           Foreground="#CBD5E1"
                                           HorizontalAlignment="Left"
                                           Margin="0,8,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.9"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>
            </Border>
        </Grid>

        <!-- 4. BOTTOM CONTROLS (Image 2) -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <CheckBox Content="Apply changes to songs in schedule (linked)" 
                      IsChecked="True" 
                      VerticalAlignment="Center" 
                      FontSize="11" 
                      Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Click="OnSaveClicked" Width="75" Height="24" Margin="0,0,6,0" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                <Button Content="Cancel" Click="OnCancelClicked" Width="75" Height="24" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
