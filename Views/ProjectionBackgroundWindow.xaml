<Window x:Class="LuxPresenter.Views.ProjectionBackgroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:LuxPresenter.Views.Components"
        Title="LuxPresenter Background Video"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        ShowInTaskbar="False"
        Topmost="False">
    <Grid Background="Black">
        <!-- Hardware Accelerated LibMPV Player Dual-Deck for Seamless Blend Crossfade -->
        <components:MpvVideoView x:Name="MpvViewA"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"/>
        <components:MpvVideoView x:Name="MpvViewB"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"/>
    </Grid>
</Window>
