<UserControl x:Class="LuxPresenter.Views.Components.SlidePaneView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             xmlns:converters="clr-namespace:LuxPresenter.Converters"

             xmlns:components="clr-namespace:LuxPresenter.Views.Components"

             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

             mc:Ignorable="d" 

             d:DesignHeight="650" d:DesignWidth="450">

    <UserControl.Resources>

        <converters:HexOrImageBrushConverter x:Key="HexOrImageBrushConverter"/>

        

        <!-- Stanza Header Banner Color Converter (Blue for Verse, Maroon for Chorus, Green for Bridge) -->

        <Style x:Key="StanzaHeaderStyle" TargetType="Border">

            <Setter Property="Padding" Value="6,2"/>

            <Setter Property="Margin" Value="0,4,0,2"/>

            <Setter Property="CornerRadius" Value="1"/>

            <Setter Property="Background" Value="#1E60D2"/>

            <Setter Property="Visibility" Value="Visible"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding Label}" Value="">

                    <Setter Property="Visibility" Value="Collapsed"/>

                </DataTrigger>

                <DataTrigger Binding="{Binding Label}" Value="{x:Null}">

                    <Setter Property="Visibility" Value="Collapsed"/>

                </DataTrigger>

                <DataTrigger Binding="{Binding Type}" Value="Chorus">

                    <Setter Property="Background" Value="#801848"/>

                </DataTrigger>

                <DataTrigger Binding="{Binding Type}" Value="Bridge">

                    <Setter Property="Background" Value="#15803D"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>



        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    </UserControl.Resources>



    <Grid Background="{DynamicResource WindowBgBrush}">

        <Grid.RowDefinitions>

            <!-- 1. Header Bar: "Preview - [Title]" / "Live - [Title]" -->

            <RowDefinition Height="26"/>

            <!-- 2. Main Content Viewport (Presentation Mode or Video Player Mode) -->

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- 1. PANE TITLE BAR (Classic EW 2009 style) -->

        <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">

            <DockPanel Margin="8,0,8,0">

                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">

                    <Run Text="{Binding PaneTitle}" FontWeight="Bold"/>

                    <Run Text=" - "/>

                    <Run Text="{Binding ItemTitle}" FontWeight="SemiBold"/>

                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <TextBlock Text="⚙ ▾" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" ToolTip="Pane Options"/>

                </StackPanel>

            </DockPanel>

        </Border>



        <!-- 2A. PRESENTATION MODE: Stanza List (Top) + Graphical Slide (Bottom) -->

        <Grid Grid.Row="1">

            <Grid.Style>

                <Style TargetType="Grid">

                    <Setter Property="Visibility" Value="Visible"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsMediaMode}" Value="True">

                            <Setter Property="Visibility" Value="Collapsed"/>

                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsPresentationDocMode}" Value="True">

                            <Setter Property="Visibility" Value="Collapsed"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Grid.Style>



            <Grid.RowDefinitions>

                <!-- Upper Viewport: Stanzas / Verses Text List -->

                <RowDefinition Height="3*" MinHeight="140"/>

                <!-- Splitter -->

                <RowDefinition Height="5"/>

                <!-- Lower Viewport: Rendered Graphic Slide (With letterbox) -->

                <RowDefinition Height="3*" MinHeight="150"/>

            </Grid.RowDefinitions>



            <!-- UPPER HALF: STANZAS / VERSES LIST (Matching Image 1 & Image 5) -->

            <Border Grid.Row="0" Background="{DynamicResource ListBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">

                <ListBox x:Name="StanzaListBox"

                         ItemsSource="{Binding Slides}"

                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"

                         BorderThickness="0"

                         ScrollViewer.CanContentScroll="False"

                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                         ScrollViewer.VerticalScrollBarVisibility="Auto"

                         Background="{DynamicResource ListBgBrush}">

                    <ListBox.Resources>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CBD5E1"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>

                    </ListBox.Resources>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel Margin="0">

                                <!-- Banner Tag (Blue for Verse, Maroon for Chorus) -->

                                <Border Style="{StaticResource StanzaHeaderStyle}">

                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="White"/>

                                </Border>

                                <!-- Verse Text Lines -->

                                <TextBlock Text="{Binding Content}" 

                                           FontSize="11" 

                                           FontFamily="Tahoma" 

                                           Margin="6,2,6,2" 

                                           TextWrapping="Wrap"

                                           LineHeight="17">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Foreground" Value="{DynamicResource ListItemTextBrush}"/>

                                            <Style.Triggers>

                                                <!-- White text when selected in Active Pane -->

                                                <MultiDataTrigger>

                                                    <MultiDataTrigger.Conditions>

                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>

                                                        <Condition Binding="{Binding DataContext.IsActivePane, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>

                                                    </MultiDataTrigger.Conditions>

                                                    <Setter Property="Foreground" Value="White"/>

                                                </MultiDataTrigger>

                                                <!-- Inactive Selection text color -->

                                                <MultiDataTrigger>

                                                    <MultiDataTrigger.Conditions>

                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>

                                                        <Condition Binding="{Binding DataContext.IsActivePane, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"/>

                                                    </MultiDataTrigger.Conditions>

                                                    <Setter Property="Foreground" Value="{DynamicResource InactiveSelectionTextBrush}"/>

                                                </MultiDataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>



                    <!-- Full-row highlight for selected stanza -->

                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem">

                            <Setter Property="Padding" Value="6,3"/>

                            <Setter Property="Margin" Value="{Binding ContainerMargin}"/>

                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                            <Setter Property="Background" Value="Transparent"/>

                            <Setter Property="BorderBrush" Value="Transparent"/>

                            <Setter Property="BorderThickness" Value="1"/>

                            <Setter Property="SnapsToDevicePixels" Value="True"/>

                            <EventSetter Event="MouseDoubleClick" Handler="OnSlideItemDoubleClick"/>

                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnSlideItemPreviewMouseLeftButtonDown"/>

                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnSlideItemPreviewMouseRightButtonDown"/>

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border x:Name="ItemBorder"

                                                Background="{TemplateBinding Background}"

                                                BorderBrush="{TemplateBinding BorderBrush}"

                                                BorderThickness="{TemplateBinding BorderThickness}"

                                                Padding="{TemplateBinding Padding}"

                                                CornerRadius="1"

                                                SnapsToDevicePixels="True">

                                            <ContentPresenter />

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>

                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}"/>

                                            </Trigger>



                                            <!-- Inactive / Prepared Selection (Gray) -->

                                            <Trigger Property="IsSelected" Value="True">

                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource InactiveSelectionBgBrush}"/>

                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource InactiveSelectionBorderBrush}"/>

                                                <Setter Property="Foreground" Value="{DynamicResource InactiveSelectionTextBrush}"/>

                                            </Trigger>



                                            <!-- Active Pane: solid blue highlight (whether Preview or Live, only if this pane is active!) -->

                                            <MultiDataTrigger>

                                                <MultiDataTrigger.Conditions>

                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>

                                                    <Condition Binding="{Binding DataContext.IsActivePane, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>

                                                </MultiDataTrigger.Conditions>

                                                <Setter TargetName="ItemBorder" Property="Background" Value="#0078D7"/>

                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#005A9E"/>

                                                <Setter Property="Foreground" Value="White"/>

                                            </MultiDataTrigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </ListBox.ItemContainerStyle>

                </ListBox>

            </Border>



            <!-- SPLITTER -->

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource SplitterBgBrush}" Cursor="SizeNS"/>



            <!-- LOWER HALF: RENDERED GRAPHICAL SLIDE VIEWPORT (Letterboxed, Aspect Ratio preserved) -->

            <Border Grid.Row="2" Background="#2B2B2B" Padding="12,8">

                <Viewbox Stretch="Uniform" StretchDirection="Both">

                    <!-- Slide Canvas (16:9 widescreen or 4:3 display ratio, exact replica of Image 1, 2, 5) -->

                    <Border Width="640" Height="360" Background="Black" ClipToBounds="True">

                        <Grid>

                            <!-- Solid Color / Default Background layer -->

                            <Rectangle x:Name="BackgroundRect" Fill="{Binding Background, Converter={StaticResource HexOrImageBrushConverter}}" Panel.ZIndex="0"/>



                            <!-- Double-buffered Image / Video Thumbnail Background layers (Fitted to 16:9 view) -->

                            <Image x:Name="BackgroundImageA" Stretch="Fill" Opacity="0" Visibility="Collapsed" Panel.ZIndex="1"/>

                            <Image x:Name="BackgroundImageB" Stretch="Fill" Opacity="0" Visibility="Collapsed" Panel.ZIndex="1"/>



                            <!-- Dark overlay tint if needed for contrast -->

                            <Rectangle Fill="#1A000000" Panel.ZIndex="3"/>



                            <!-- Slide Text Content Layout -->

                            <Grid x:Name="SlideTextContentGrid" Margin="36,8,36,24" Panel.ZIndex="10">

                                <Grid.Style>

                                    <Style TargetType="Grid">

                                        <Setter Property="Visibility" Value="Visible"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding CurrentSlide}" Value="{x:Null}">

                                                <Setter Property="Visibility" Value="Collapsed"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Grid.Style>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="*"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>



                                <!-- Scripture Reference Header if present (Collapsed for songs so song title is NOT shown on slide) -->

                                <TextBlock Grid.Row="0" 

                                           Text="{Binding CurrentSlide.Title}" 

                                           FontSize="16" 

                                           FontFamily="Tahoma"

                                           FontWeight="Bold" 

                                           Foreground="White"

                                           HorizontalAlignment="Center">

                                    <TextBlock.Effect>

                                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Direction="315" Opacity="0.95"/>

                                    </TextBlock.Effect>

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding CurrentSlide.Type}" Value="Scripture">

                                                    <Setter Property="Visibility" Value="Visible"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>



                                <!-- Main Stanza Lyrics / Scripture Text (Centered, Bold Tahoma/Arial, Crisp Black Outline) -->

                                <Viewbox x:Name="ContentViewbox" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">

                                    <components:OutlinedTextBlock x:Name="ContentTextBlock"

                                                                  Width="568"

                                                                  FontFamily="Arial, Tahoma"

                                                                  FontSize="42"

                                                                  FontWeight="Bold"

                                                                  Fill="White"

                                                                  Stroke="Black"

                                                                  StrokeThickness="3.0"

                                                                  TextAlignment="Center"

                                                                  TextWrapping="Wrap"/>

                                </Viewbox>



                                <!-- Footer Reference (Bottom Right: "Genesis 1:1" or Song Title) -->

                                <TextBlock Grid.Row="2"

                                           Text="{Binding CurrentSlide.Label}"

                                           FontFamily="Tahoma"

                                           FontSize="16"

                                           FontWeight="Bold"

                                           Foreground="White"

                                           HorizontalAlignment="Right"

                                           VerticalAlignment="Bottom">

                                    <TextBlock.Effect>

                                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Direction="315" Opacity="0.95"/>

                                    </TextBlock.Effect>

                                </TextBlock>

                            </Grid>



                            <!-- Live Alert Ticker Preview (Image 10) -->

                            <Grid x:Name="LiveAlertBanner" 

                                  VerticalAlignment="Bottom" 

                                  Height="24" 

                                  Background="#FF0000" 

                                  Visibility="Collapsed" 

                                  ClipToBounds="True"

                                  Panel.ZIndex="20">

                                <Canvas x:Name="LiveAlertCanvas" Height="24">

                                    <TextBlock x:Name="LiveAlertTextBlock" 

                                               Canvas.Top="2"

                                               FontFamily="Tahoma, Arial Black" 

                                               FontSize="14" 

                                               FontWeight="Bold" 

                                               Foreground="White">

                                        <TextBlock.Effect>

                                            <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Direction="315" Opacity="0.95"/>

                                        </TextBlock.Effect>

                                    </TextBlock>

                                </Canvas>

                            </Grid>



                            <!-- Solid Black Overlay for Black Button (Matching Image 4) -->

                            <Rectangle x:Name="BlackOverlayRect" Fill="Black" Visibility="Collapsed" Opacity="0" Panel.ZIndex="30"/>

                        </Grid>

                    </Border>

                </Viewbox>

            </Border>

        </Grid>



        <!-- 2B. MEDIA PLAYER MODE: Standalone Video Player with Transport Controls (Matching Image 2) -->

        <Grid Grid.Row="1" Background="#333333">

            <Grid.Style>

                <Style TargetType="Grid">

                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsMediaMode}" Value="True">

                            <Setter Property="Visibility" Value="Visible"/>

                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsPresentationDocMode}" Value="True">

                            <Setter Property="Visibility" Value="Collapsed"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Grid.Style>



            <Grid.RowDefinitions>

                <!-- Video Screen -->

                <RowDefinition Height="*"/>

                <!-- Transport Controls Bar -->

                <RowDefinition Height="120"/>

            </Grid.RowDefinitions>



            <!-- Video Screen Viewport -->

            <Border Grid.Row="0" Background="#000000" Margin="16,16,16,8" CornerRadius="3" BorderBrush="#222222" BorderThickness="2">

                <Grid>

                    <!-- Fallback MediaElement Video Player (Native Windows, always works) -->

                    <MediaElement x:Name="PlayerMediaElement"

                                  LoadedBehavior="Manual"

                                  UnloadedBehavior="Stop"

                                  Stretch="Uniform"

                                  IsMuted="False"

                                  Visibility="Collapsed"/>



                    <!-- Actual Video Player LibMPV VideoView (Preview Pane Only) -->

                    <components:MpvVideoView x:Name="PlayerMpvView" 

                                             HorizontalAlignment="Stretch" 

                                             VerticalAlignment="Stretch">

                        <components:MpvVideoView.Style>

                            <Style TargetType="components:MpvVideoView">

                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsLiveMode}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </components:MpvVideoView.Style>

                    </components:MpvVideoView>



                    <!-- Text displayed in Live pane while video is playing on live output -->

                    <TextBlock Text="(video playing on live output)" 

                               Foreground="#888888" 

                               FontSize="14" 

                               FontStyle="Italic"

                               HorizontalAlignment="Center" 

                               VerticalAlignment="Center">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsLiveMode}" Value="True">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

            </Border>



            <!-- Glossy Silver Transport Controls (Matching Image 2) -->

            <Grid Grid.Row="1" Margin="16,0,16,12">

                <Grid.RowDefinitions>

                    <!-- Time Display & Scrubber -->

                    <RowDefinition Height="Auto"/>

                    <!-- Playback Buttons Bar -->

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <!-- Scrubber Slider & Time text -->

                <Grid Grid.Row="0" Margin="0,4,0,8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>



                    <Slider Grid.Column="0" 

                            x:Name="MediaSlider"

                            Value="{Binding CurrentPosition, Mode=TwoWay}" 

                            Minimum="0"

                            Maximum="100" 

                            IsMoveToPointEnabled="True"

                            VerticalAlignment="Center" 

                            Margin="0,0,12,0"/>



                    <TextBlock Grid.Column="1" 

                               Text="{Binding TimeDisplayText}" 

                               Foreground="#E2E8F0" 

                               FontSize="11" 

                               FontFamily="Tahoma" 

                               VerticalAlignment="Center"/>

                </Grid>



                <!-- Buttons: [↻ Loop]   [|◀◀ Rewind]  (▶ / ⏸ Play)  [▶▶| Fwd]   [🔊 Volume] -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>



                    <!-- Loop Toggle Button (↻) with Visual Active/Inactive Highlight -->

                    <ToggleButton Grid.Column="0" 

                                  IsChecked="{Binding IsLooping, Mode=TwoWay}"

                                  Width="32" Height="30" 

                                  FontSize="16" 

                                  FontWeight="Bold"

                                  VerticalAlignment="Center">

                        <ToggleButton.Style>

                            <Style TargetType="ToggleButton">

                                <Setter Property="Background" Value="Transparent"/>

                                <Setter Property="BorderThickness" Value="1"/>

                                <Setter Property="BorderBrush" Value="Transparent"/>

                                <Setter Property="Foreground" Value="#64748B"/>

                                <Setter Property="ToolTip" Value="Loop: Off (Click to Enable)"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ToggleButton">

                                            <Border Background="{TemplateBinding Background}"

                                                    BorderBrush="{TemplateBinding BorderBrush}"

                                                    BorderThickness="{TemplateBinding BorderThickness}"

                                                    CornerRadius="3">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsChecked" Value="True">

                                        <Setter Property="Background" Value="#1E293B"/>

                                        <Setter Property="BorderBrush" Value="#38BDF8"/>

                                        <Setter Property="Foreground" Value="#38BDF8"/>

                                        <Setter Property="ToolTip" Value="Loop: On (Click to Disable)"/>

                                    </Trigger>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Opacity" Value="0.85"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </ToggleButton.Style>

                        ↻

                    </ToggleButton>



                    <!-- Center Transport Buttons: Rewind, Big Play/Pause, Forward -->

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- Rewind |◀◀ -->

                        <Button Command="{Binding RewindCommand}" 

                                Width="36" Height="28" 

                                Margin="2,0" 

                                Background="#CBD5E1" 

                                BorderBrush="#94A3B8" 

                                FontSize="10" 

                                ToolTip="Rewind">

                            ◀◀

                        </Button>



                        <!-- Big Glossy Silver Play / Pause Button -->

                        <Button Command="{Binding PlayPauseCommand}" 

                                Width="44" Height="44" 

                                Margin="6,0" 

                                Background="#E2E8F0" 

                                BorderBrush="#64748B" 

                                BorderThickness="2"

                                Cursor="Hand"

                                ToolTip="Play / Pause">

                            <TextBlock FontSize="18" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Text" Value="▶"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">

                                                <Setter Property="Text" Value="⏸"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </Button>



                        <!-- Forward ▶▶| -->

                        <Button Command="{Binding ForwardCommand}" 

                                Width="36" Height="28" 

                                Margin="2,0" 

                                Background="#CBD5E1" 

                                BorderBrush="#94A3B8" 

                                FontSize="10" 

                                ToolTip="Forward">

                            ▶▶

                        </Button>

                    </StackPanel>



                    <!-- Speaker Icon & Volume Slider -->

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="🔊" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>

                        <Slider Width="70" 

                                Value="{Binding Volume, Mode=TwoWay}" 

                                Minimum="0" Maximum="1" 

                                IsMoveToPointEnabled="True"

                                SmallChange="0.05"

                                LargeChange="0.1"

                                VerticalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>



        <!-- 2C. PRESENTATION DOCUMENT MODE: Static Vector in Preview | WebView2 in Live Output -->

        <Grid Grid.Row="1" Background="#0F172A">

            <Grid.Style>

                <Style TargetType="Grid">

                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsPresentationDocMode}" Value="True">

                            <Setter Property="Visibility" Value="Visible"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Grid.Style>



            <Grid.RowDefinitions>

                <!-- Viewport -->

                <RowDefinition Height="*"/>

                <!-- Transport Controls Bar -->

                <RowDefinition Height="46"/>

            </Grid.RowDefinitions>



            <!-- VIEWPORT -->

            <Border Grid.Row="0" Background="#000000" Margin="10,10,10,4" CornerRadius="3" BorderBrush="#1E293B" BorderThickness="1.5">

                <Grid>

                    <!-- Empty placeholder if no presentation slide is loaded -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPresentationSlide}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📽️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.4"/>
                        <TextBlock Text="No presentation document selected" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="Import a .pptx or .pdf presentation in Library" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Preview Mode: Native WPF High-Quality Static Image (100% Static, Zero JS overhead) -->

                    <Viewbox x:Name="PresPreviewViewbox" Stretch="Uniform" StretchDirection="Both">

                        <Viewbox.Style>

                            <Style TargetType="Viewbox">

                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsLiveMode}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Viewbox.Style>

                        <Image Source="{Binding CurrentPresentationSlide.ImagePreviewPath}" 

                               Stretch="Uniform" 

                               SnapsToDevicePixels="True" 

                               RenderOptions.BitmapScalingMode="HighQuality"/>

                    </Viewbox>



                    <!-- Live Mode: Static Viewport mirror in Pane (Hardware Accelerated) -->

                    <Viewbox x:Name="PresLiveViewbox" Stretch="Uniform" StretchDirection="Both">

                        <Viewbox.Style>

                            <Style TargetType="Viewbox">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsLiveMode}" Value="True">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Viewbox.Style>

                        <Image Source="{Binding CurrentPresentationSlide.ImagePreviewPath}" 

                               Stretch="Uniform" 

                               SnapsToDevicePixels="True" 

                               RenderOptions.BitmapScalingMode="HighQuality"/>

                    </Viewbox>

                </Grid>

            </Border>



            <!-- TRANSPORT CONTROLS BAR -->

            <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="8,4">

                <DockPanel>

                    <!-- Navigation Buttons -->

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">

                        <Button Command="{Binding PrevSlideCommand}" Content="◀ Prev Slide" Padding="8,3" Margin="0,0,4,0" FontSize="11" Background="#334155" Foreground="#F8FAFC" BorderBrush="#475569" Cursor="Hand" ToolTip="Go to previous slide"/>

                        <Button Command="{Binding NextSlideCommand}" Content="Next Slide ▶" Padding="8,3" Margin="0,0,8,0" FontSize="11" Background="#334155" Foreground="#F8FAFC" BorderBrush="#475569" Cursor="Hand" ToolTip="Go to next slide"/>

                    </StackPanel>



                    <!-- Status Display -->

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">

                        <!-- Preview Status -->

                        <TextBlock Text="{Binding ItemSubtitle}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility" Value="Visible"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsLiveMode}" Value="True">

                                            <Setter Property="Visibility" Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>



                        <!-- Live Status -->

                        <TextBlock Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsLiveMode}" Value="True">

                                            <Setter Property="Visibility" Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                            <Run Text="LIVE ● "/>

                            <Run Text="{Binding ItemSubtitle, Mode=OneWay}"/>

                        </TextBlock>

                    </StackPanel>

                </DockPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>

