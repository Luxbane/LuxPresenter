<UserControl x:Class="LuxPresenter.Views.Components.PresentationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:LuxPresenter.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="320">
    
    <UserControl.Resources>
        <converters:HexOrImageBrushConverter x:Key="HexOrImageBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PanelBgBrush}">
        <Grid.RowDefinitions>
            <!-- 1. Top Document Selector Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Slide Thumbnail Grid -->
            <RowDefinition Height="*"/>
            <!-- 3. Bottom Actions Toolbar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP DOCUMENT SELECTOR BAR (Consistent with MediaTab & SongsTab) -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBgBrush}" Padding="6,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="📽️" FontSize="14" VerticalAlignment="Center" Margin="2,0,6,0"/>

                <ComboBox Grid.Row="0" Grid.Column="1" 
                          ItemsSource="{Binding PresentationDocs}" 
                          SelectedItem="{Binding SelectedDoc, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          FontSize="11" Height="24" VerticalAlignment="Center"/>

                <Button Grid.Row="0" Grid.Column="2" 
                        Command="{Binding AddDocumentCommand}" 
                        Content="➕" Width="26" Height="24" Margin="4,0,0,0" FontSize="11" 
                        ToolTip="Import New Presentation"/>

                <!-- Search / Filter input -->
                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                         Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="11" Margin="2,4,0,0" Height="22" 
                         VerticalContentAlignment="Center" Padding="4,1"
                         ToolTip="Filter Documents..."/>
            </Grid>
        </Border>

        <!-- 2. SLIDE THUMBNAIL GRID (VirtualizingWrapPanel, Lazy Loaded) -->
        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Slides}"
                     SelectedItem="{Binding SelectedSlide, Mode=TwoWay}"
                     SelectedIndex="{Binding SelectedSlideIndex, Mode=TwoWay}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     Background="{DynamicResource ListBgBrush}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Slide Card -->
                        <Border Width="96" Height="74" Margin="4" CornerRadius="3" BorderBrush="#334155" BorderThickness="1.5"
                                Background="#0B192C" Cursor="Hand" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Thumbnail Image if available, otherwise dark canvas -->
                                <Image Stretch="UniformToFill" Margin="1"
                                       Source="{Binding ThumbnailPath}"/>

                                <!-- Slide Index Badge (Top Left) -->
                                <Border Background="#D00F172A" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="4,1" CornerRadius="1,0,3,0">
                                    <TextBlock Text="{Binding Index, StringFormat='Slide {0}'}" FontSize="8" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>

                                <!-- Live Indicator Badge (Top Right - Green glowing) -->
                                <Border Background="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,1" CornerRadius="0,1,0,3"
                                        Visibility="{Binding IsCurrentlyLive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <EventSetter Event="MouseDoubleClick" Handler="OnSlideDoubleClick"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnSlideClick"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#38BDF8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Loading indicator overlay -->
            <Border Background="#60000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,0,6"/>
                    <TextBlock Text="Loading Document..." FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. BOTTOM ACTIONS TOOLBAR (Consistent with MediaTab) -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="6,3">
            <DockPanel>
                <Button Content="➕ Import Presentation" Command="{Binding AddDocumentCommand}" FontSize="10" Padding="8,2" Margin="0,0,4,0" ToolTip="Import Presentation Document"/>
                <Button Content="➖ Delete Presentation" Command="{Binding DeleteDocumentCommand}" FontSize="10" Padding="8,2" Margin="0,0,4,0" ToolTip="Remove Selected Presentation"/>
                <TextBlock Text="Presentation Module" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#64748B"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
