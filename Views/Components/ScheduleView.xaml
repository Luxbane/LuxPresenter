<UserControl x:Class="LuxPresenter.Views.Components.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Background="{DynamicResource PanelBgBrush}">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="26"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header (Classic EW 2009 style) -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0,8,0">
                <TextBlock Text="Schedule" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="⚙ ▾" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" MouseLeftButtonUp="OnGearClick">
                    <TextBlock.ContextMenu>
                        <ContextMenu x:Name="ScheduleHeaderMenu">
                            <MenuItem Header="📄 New Schedule" Click="OnNewScheduleMenuClick"/>
                            <MenuItem Header="📁 Open Schedule..." Click="OnOpenScheduleMenuClick"/>
                            <MenuItem Header="💾 Save Schedule" Click="OnSaveScheduleMenuClick"/>
                            <MenuItem Header="💾 Save Schedule As..." Click="OnSaveScheduleAsMenuClick"/>
                            <Separator/>
                            <MenuItem Header="🗑 Clear Schedule" Click="OnClearScheduleMenuClick"/>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Main Body: List + Right Action Toolbar (Image 1: +, -, ▲, ▼, orange icon) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>

            <!-- Schedule Items List (Matching EW 2009 Video Frame 54) -->
            <ListBox x:Name="ScheduleListBox"
                     Grid.Column="0"
                     Background="{DynamicResource ListBgBrush}" 
                     ItemsSource="{Binding Items}" 
                     SelectedItem="{Binding SelectedItem}"
                     BorderThickness="0"
                     AllowDrop="True"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="OnSchedulePreviewMouseLeftButtonDown"
                     MouseMove="OnScheduleMouseMove"
                     DragOver="OnScheduleDragOver"
                     Drop="OnScheduleDrop"
                     KeyDown="OnScheduleKeyDown">
                <ListBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CBD5E1"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1E293B"/>
                </ListBox.Resources>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="▶ Go Live" Command="{Binding DoubleClickCommand}"/>
                        <Separator/>
                        <MenuItem Header="▲ Move Up" Command="{Binding MoveUpCommand}"/>
                        <MenuItem Header="▼ Move Down" Command="{Binding MoveDownCommand}"/>
                        <Separator/>
                        <MenuItem Header="🗑 Remove from Schedule" Command="{Binding RemoveItemCommand}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="1,2" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail with [auto] tag (Exact EW 2009 style) -->
                            <Border Grid.Column="0" Width="32" Height="22" 
                                    Background="#0A1826" 
                                    BorderBrush="#64748B" 
                                    BorderThickness="1" 
                                    CornerRadius="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Border Background="#A0000000" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="1,0">
                                        <TextBlock Text="[auto]" FontSize="7" Foreground="#F8FAFC" FontFamily="Tahoma"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Title & <notes> subtitle (Guaranteed high-contrast in all states) -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="11" FontFamily="Tahoma" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ListItemTextBrush}"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                        <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="&lt;notes&gt;" FontSize="9" FontFamily="Tahoma" Margin="0,-1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                        <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="#E0E7FF"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                        <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="OnListBoxItemDoubleClick"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnScheduleItemClick"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="Margin" Value="1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="{DynamicResource ListItemTextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="1"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}"/>
                                        </Trigger>
                                        <!-- Inactive selection (Gray highlight) -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource InactiveSelectionBgBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource InactiveSelectionBorderBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource InactiveSelectionTextBrush}"/>
                                        </Trigger>
                                        <!-- Active selection (Solid EW Blue highlight) -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0078D7"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#005A9E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Schedule Right Toolbar (+, -, Up, Down, Document) -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <StackPanel VerticalAlignment="Top" Margin="2,4,2,0">
                    <!-- Green (+) Add -->
                    <Button Command="{Binding AddItemCommand}"
                            ToolTip="Add selected item to schedule"
                            Width="22" Height="22" Margin="0,2"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="+" FontWeight="Black" FontSize="16" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Button>

                    <!-- Red/Gray (-) Remove -->
                    <Button Command="{Binding RemoveItemCommand}"
                            ToolTip="Remove selected item from schedule"
                            Width="22" Height="22" Margin="0,2"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="−" FontWeight="Black" FontSize="16" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Button>

                    <!-- Move Up (▲) -->
                    <Button Command="{Binding MoveUpCommand}"
                            ToolTip="Move item up"
                            Width="22" Height="22" Margin="0,2"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="▲" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Move Down (▼) -->
                    <Button Command="{Binding MoveDownCommand}"
                            ToolTip="Move item down"
                            Width="22" Height="22" Margin="0,2"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="▼" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Orange Overlapping Documents Icon (Schedule Properties / Menu) -->
                    <Button ToolTip="Schedule Options"
                            Click="OnSchedulePropertiesButtonClick"
                            Width="22" Height="22" Margin="0,6,0,2"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="📑" FontSize="12" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
