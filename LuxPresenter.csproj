<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LuxPresenter</AssemblyName>
    <RootNamespace>LuxPresenter</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Title>LuxPresenter</Title>
    <Product>LuxPresenter</Product>
    <Authors>Luxbane</Authors>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app_icon.png" />
    <None Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Extensions\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="vulkan-1.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="D3DCompiler_43.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="D3DCompiler_47.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="impress_bridge.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

</Project>
