<Window x:Class="LuxPresenter.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:components="clr-namespace:LuxPresenter.Views.Components"

        xmlns:converters="clr-namespace:LuxPresenter.Converters"

        mc:Ignorable="d"

        Title="LuxPresenter - Default Profile" 

        Icon="app_icon.png"

        WindowState="Maximized"

        Height="620" Width="1024"

        MinHeight="460" MinWidth="750"

        WindowStartupLocation="CenterScreen"

        Background="{DynamicResource WindowBgBrush}">



    <Window.Resources>

        <converters:BoolToActiveBrushConverter x:Key="BoolToActiveBrushConverter"/>

        

        <!-- Classic Toolbar Icon Button Style -->

        <Style x:Key="ClassicIconBtn" TargetType="Button">

            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderBrush" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="4,2"/>

            <Setter Property="Margin" Value="1"/>

            <Setter Property="Height" Value="28"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>

                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>

                </Trigger>

                <Trigger Property="IsPressed" Value="True">

                    <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Toggle Button for Logo, Black, Clear (EW 2009 Style) -->

        <Style x:Key="EWToggleBtn" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderBrush" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="6,2"/>

            <Setter Property="Margin" Value="2,0"/>

            <Setter Property="Height" Value="28"/>

            <Setter Property="FontSize" Value="11"/>

            <Setter Property="FontFamily" Value="Tahoma"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>

                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>

                </Trigger>

                <Trigger Property="IsChecked" Value="True">

                    <Setter Property="Background" Value="#2563EB"/>

                    <Setter Property="BorderBrush" Value="#3B82F6"/>

                    <Setter Property="Foreground" Value="#FFFFFF"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.RowDefinitions>

            <!-- 1. Menu Bar -->

            <RowDefinition Height="Auto"/>

            <!-- 2. Main Tool Bar -->

            <RowDefinition Height="Auto"/>

            <!-- 3. Work Area (3 Columns: Left Schedule/Library, Center Preview, Right Live) -->

            <RowDefinition Height="*"/>

            <!-- 4. Status Bar -->

            <RowDefinition Height="22"/>

        </Grid.RowDefinitions>



        <!-- 1. MENU BAR (File, Schedule, Songs, Live, Profiles, Help) -->

        <Menu Grid.Row="0" Background="{DynamicResource MenuBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" FontSize="11" FontFamily="Tahoma">

            <MenuItem Header="_File">

                <MenuItem Header="New Schedule" InputGestureText="Ctrl+N" Click="OnNewScheduleClick"/>

                <MenuItem Header="Open Schedule..." InputGestureText="Ctrl+O" Click="OnOpenScheduleClick"/>

                <MenuItem Header="Save Schedule" InputGestureText="Ctrl+S" Click="OnSaveScheduleClick"/>

                <MenuItem Header="Save Schedule As..." InputGestureText="Ctrl+Shift+S" Click="OnSaveScheduleAsClick"/>

                <Separator/>

                <MenuItem Header="Open Songs Database Folder..." Click="OnOpenSongsFolderClick"/>

                <Separator/>

                <MenuItem Header="Options..." Command="{Binding OpenProjectorWindowCommand}"/>

                <Separator/>

                <MenuItem Header="Exit" Click="OnMenuExitClick"/>

            </MenuItem>

            <MenuItem Header="_Schedule">

                <MenuItem Header="New Schedule" Click="OnNewScheduleClick"/>

                <MenuItem Header="Open Schedule..." Click="OnOpenScheduleClick"/>

                <MenuItem Header="Save Schedule" Click="OnSaveScheduleClick"/>

                <MenuItem Header="Save Schedule As..." Click="OnSaveScheduleAsClick"/>

                <Separator/>

                <MenuItem Header="Add Item..." Command="{Binding ScheduleVM.AddItemCommand}"/>

                <MenuItem Header="Clear Schedule" Click="OnClearScheduleClick"/>

            </MenuItem>

            <MenuItem Header="_Songs">

                <MenuItem Header="New Song..." Command="{Binding SongsVM.NewSongCommand}"/>

                <MenuItem Header="Edit Selected Song" Command="{Binding EditActiveSongCommand}"/>

                <MenuItem Header="Delete Selected Song" Command="{Binding SongsVM.DeleteSongCommand}"/>

                <Separator/>

                <MenuItem Header="Open Songs Database Folder..." Click="OnOpenSongsFolderClick"/>

                <MenuItem Header="Change Database Folder..." Click="OnChangeSongsFolderClick"/>

                <Separator/>

                <MenuItem Header="Import Song Library Backup (.json)..." Click="OnImportSongBackupClick"/>

                <MenuItem Header="Export Song Library Backup (.json)..." Click="OnExportSongBackupClick"/>

                <Separator/>

                <MenuItem Header="Load Default Sample Songs" Click="OnLoadSampleSongsClick"/>

            </MenuItem>

            <MenuItem Header="Scri_ptures">

                <MenuItem Header="Import Bible Translation (.json)..." Click="OnImportBibleClick"/>

            </MenuItem>

            <MenuItem Header="_Live">

                <MenuItem Header="Go Live" InputGestureText="Space" Command="{Binding GoLiveCommand}"/>

                <MenuItem Header="Black" InputGestureText="Ctrl+B" Command="{Binding BlackCommand}"/>

                <MenuItem Header="Clear" InputGestureText="Ctrl+C" Command="{Binding ClearCommand}"/>

                <MenuItem Header="Logo" InputGestureText="F8" Command="{Binding LogoCommand}"/>

                <MenuItem Header="Live Output" Command="{Binding LiveToggleCommand}"/>

            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem x:Name="MenuThemeToggle" Header="🌙 Dark Mode" InputGestureText="Ctrl+T" Click="OnToggleThemeClick"/>
            </MenuItem>

            <MenuItem Header="_Profiles">

                <MenuItem Header="Default Profile" IsChecked="True"/>

                <Separator/>

                <MenuItem Header="Export Songs Profile..." Click="OnExportSongBackupClick"/>

                <MenuItem Header="Import Songs Profile..." Click="OnImportSongBackupClick"/>

            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Check for Updates..." Click="OnCheckUpdatesClick"/>
                <Separator/>
                <MenuItem Header="☕ Support &amp; Donate (Ko-fi)..." Click="OnDonateKofiClick"/>
                <Separator/>
                <MenuItem Header="About LuxPresenter" Click="OnMenuAboutClick"/>
            </MenuItem>

        </Menu>



        <!-- 2. UPPER TOOLBAR (Exact 1:1 Match of Image 1, 3, 5) -->

        <Border Grid.Row="1" Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">

            <DockPanel Margin="4,2,4,2">

                <!-- Left Toolbar Actions -->

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                    <!-- Add Song (green plus) -->

                    <Button Style="{StaticResource ClassicIconBtn}" Command="{Binding SongsVM.NewSongCommand}" ToolTip="New Song">

                        <Viewbox Width="15" Height="15">
                            <Canvas Width="16" Height="16">
                                <Path Data="M8 2v12 M2 8h12" Stroke="#22C55E" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                    </Button>

                    <!-- Edit Song (pencil on sheet) -->

                    <Button Style="{StaticResource ClassicIconBtn}" Command="{Binding EditActiveSongCommand}" ToolTip="Edit Active Song">

                        <Viewbox Width="15" Height="15">
                            <Canvas Width="16" Height="16">
                                <Path Data="M11.5 2.5a1.414 1.414 0 0 1 2 2L5 13H2.5v-2.5L11.5 2.5z" Fill="#38BDF8" Stroke="#0284C7" StrokeThickness="0.6"/>
                                <Line X1="9.5" Y1="4.5" X2="11.5" Y2="6.5" Stroke="#0284C7" StrokeThickness="0.6"/>
                            </Canvas>
                        </Viewbox>

                    </Button>

                    <!-- Display Options (CRT monitor with blue screen) -->

                    <Button Style="{StaticResource ClassicIconBtn}" Command="{Binding OpenProjectorWindowCommand}" ToolTip="Options (Projector Setup)">

                        <Viewbox Width="16" Height="15">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="1.5" Canvas.Top="2" Width="13" Height="9" RadiusX="1" RadiusY="1" Fill="#60A5FA" Stroke="#2563EB" StrokeThickness="0.8"/>
                                <Rectangle Canvas.Left="3" Canvas.Top="3.5" Width="10" Height="6" Fill="#1E293B"/>
                                <Path Data="M8 11v3 M5 14h6" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                    </Button>

                    <!-- Web (globe with green arrow) -->

                    <Button Style="{StaticResource ClassicIconBtn}" Click="OnGlobeButtonClick" ToolTip="Online Web Integration">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="16" Height="16">
                                <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="13" Stroke="#10B981" StrokeThickness="1.4"/>
                                <Path Data="M1.5 8h13 M8 1.5c-2.5 3-2.5 10 0 13 M8 1.5c2.5 3 2.5 10 0 13" Stroke="#10B981" StrokeThickness="1.1"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Donate / Support on Ko-fi -->
                    <Button Style="{StaticResource ClassicIconBtn}" 
                            Click="OnDonateKofiClick" 
                            ToolTip="Support LuxPresenter on Ko-fi (https://ko-fi.com/luxbane)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Margin="0,0,4,0">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M3 5h8v5a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V5z M11 6h1.5a1.5 1.5 0 0 1 0 3H11" Stroke="#F59E0B" Fill="#FBBF24" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                    <Path Data="M5 2c0 1 1 1.5 1 2.5 M8 1.5c0 1 1 1.5 1 2.5" Stroke="#F59E0B" StrokeThickness="1" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Donate" FontSize="11" FontFamily="Tahoma" FontWeight="SemiBold" Foreground="{DynamicResource DonateBtnTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Dark / Light Mode Toggle Button -->
                    <Button x:Name="BtnThemeToggle"
                            Style="{StaticResource ClassicIconBtn}"
                            Click="OnToggleThemeClick"
                            ToolTip="Toggle Dark / Light Mode (Ctrl+T)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="12" Margin="0,0,4,0" Foreground="#FBBF24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtThemeLabel" Text="Dark" FontSize="11" FontFamily="Tahoma" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>



                <!-- Right Toolbar Actions (Background ▾, Go Live, Alert, Logo, Black, Clear, Live) -->

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">

                    <!-- Background ▾ Button → opens Background Options dialog -->

                    <Button Style="{StaticResource ClassicIconBtn}"

                            Click="OnBackgroundBtnClick"

                            Margin="0,0,8,0"

                            ToolTip="Background Options">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Viewbox Width="14" Height="14" Margin="0,0,4,0">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="1.5" Canvas.Top="2" Width="13" Height="12" RadiusX="1.5" RadiusY="1.5" Stroke="#818CF8" StrokeThickness="1.2" Fill="#6366F1" Opacity="0.2"/>
                                    <Rectangle Canvas.Left="1.5" Canvas.Top="2" Width="13" Height="12" RadiusX="1.5" RadiusY="1.5" Stroke="#818CF8" StrokeThickness="1.2"/>
                                    <Ellipse Canvas.Left="10" Canvas.Top="4.5" Width="2.5" Height="2.5" Fill="#F59E0B"/>
                                    <Path Data="M3 12.5l3.5-4 2.5 3 2-2 3.5 3" Stroke="#818CF8" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="Background" FontSize="11" FontFamily="Tahoma" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <TextBlock Text=" ▾" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>



                    <!-- GO LIVE BUTTON (Green right-arrow with two blue screens) -->

                    <Button Command="{Binding GoLiveCommand}"

                            Background="{DynamicResource ButtonBgBrush}" 

                            BorderBrush="{DynamicResource ButtonBorderBrush}" 

                            BorderThickness="1"

                            Padding="8,2" 

                            Margin="0,0,8,0" 

                            Cursor="Hand"

                            ToolTip="Go Live (Space)">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <TextBlock Text="▶" Foreground="#16A34A" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Go Live" FontSize="11" FontFamily="Tahoma" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>



                    <!-- Alert (Yellow Triangle ▾) -->

                    <Button Style="{StaticResource ClassicIconBtn}" 

                            Click="OnAlertBtnClick" 

                            ToolTip="Alert Message">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Viewbox Width="14" Height="14" Margin="0,0,2,0">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M8 1.5l7 12H1z" Fill="#FEF08A" Stroke="#EAB308" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                    <Path Data="M8 5.5v4 M8 11.5v0.01" Stroke="#854D0E" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,0" VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>



                    <!-- Logo (Blue monitor with church logo) -->

                    <ToggleButton Style="{StaticResource EWToggleBtn}" 

                                  IsChecked="{Binding IsLogoActive, Mode=OneWay}"

                                  Command="{Binding LogoCommand}"

                                  ToolTip="Logo (F8)">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Viewbox Width="13" Height="13" Margin="0,0,4,0">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="1" Canvas.Top="2" Width="14" Height="10" RadiusX="1" RadiusY="1" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2"/>
                                    <Path Data="M8 4v6 M6 6h4" Stroke="#38BDF8" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M8 12v2 M5 14h6" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="Logo" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        </StackPanel>

                    </ToggleButton>



                    <!-- Black (Monitor with solid black screen) - Ctrl+B -->

                    <ToggleButton Style="{StaticResource EWToggleBtn}" 

                                  IsChecked="{Binding IsBlackActive, Mode=OneWay}"

                                  Command="{Binding BlackCommand}"

                                  ToolTip="Black (Ctrl+B)">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Border Width="11" Height="11" Background="Black" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1" CornerRadius="1" Margin="0,0,4,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        </StackPanel>

                    </ToggleButton>



                    <!-- Clear (Monitor with clear slash) - Ctrl+C -->

                    <ToggleButton Style="{StaticResource EWToggleBtn}" 

                                  IsChecked="{Binding IsClearActive, Mode=OneWay}"

                                  Command="{Binding ClearCommand}"

                                  ToolTip="Clear (Ctrl+C)">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Viewbox Width="12" Height="12" Margin="0,0,4,0">
                                <Canvas Width="16" Height="16">
                                    <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="13" Stroke="#EF4444" StrokeThickness="1.5"/>
                                    <Line X1="3.5" Y1="12.5" X2="12.5" Y2="3.5" Stroke="#EF4444" StrokeThickness="1.5"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="Clear" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        </StackPanel>

                    </ToggleButton>



                    <!-- Live Master Toggle Button (Blue glowing button on right) -->

                    <ToggleButton IsChecked="{Binding IsLiveOutputActive, Mode=TwoWay}"

                                  Margin="6,1,2,1"

                                  Padding="16,3"

                                  FontFamily="Tahoma"

                                  FontSize="11"

                                  Cursor="Hand"

                                  ToolTip="Toggle Live Output (F5)">

                        <ToggleButton.Style>

                            <Style TargetType="ToggleButton">

                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                                <Setter Property="BorderBrush" Value="#2563EB"/>

                                <Setter Property="BorderThickness" Value="1"/>

                                <Style.Triggers>

                                    <Trigger Property="IsChecked" Value="False">

                                        <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>

                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>

                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </ToggleButton.Style>

                        <TextBlock Text="Live" FontWeight="Bold"/>

                    </ToggleButton>

                </StackPanel>

            </DockPanel>

        </Border>



        <!-- 3. WORK AREA (3 COLUMNS: LEFT, CENTER PREVIEW, RIGHT LIVE) -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <!-- Left Pane: Schedule & Library -->

                <ColumnDefinition x:Name="LeftPaneColumn" Width="380" MinWidth="260" MaxWidth="650"/>

                <!-- Splitter 1 -->

                <ColumnDefinition Width="5"/>

                <!-- Center Pane: Preview -->

                <ColumnDefinition Width="1*" MinWidth="260"/>

                <!-- Splitter 2 -->

                <ColumnDefinition Width="5"/>

                <!-- Right Pane: Live -->

                <ColumnDefinition Width="1*" MinWidth="260"/>

            </Grid.ColumnDefinitions>



            <!-- LEFT SECTION (Schedule + Library) -->

            <Grid Grid.Column="0">

                <Grid.Style>

                    <Style TargetType="Grid">

                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding DataContext.IsOnlineMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                <Setter Property="Visibility" Value="Collapsed"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </Grid.Style>

                <Grid.RowDefinitions>

                    <!-- Schedule (Top) -->

                    <RowDefinition Height="240" MinHeight="140"/>

                    <!-- Vertical Splitter -->

                    <RowDefinition Height="5"/>

                    <!-- Library (Bottom: Songs, Scriptures, Media, Online) -->

                    <RowDefinition Height="1*" MinHeight="180"/>

                </Grid.RowDefinitions>



                <!-- Schedule View -->

                <components:ScheduleView Grid.Row="0" DataContext="{Binding ScheduleVM}"/>



                <!-- Horizontal Splitter -->

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource SplitterBgBrush}" Cursor="SizeNS"/>



                <!-- Library View (Tabs: Songs, Scriptures, Media, Online) -->

                <components:LibraryView x:Name="MainLibraryView" Grid.Row="2"/>

            </Grid>



            <!-- SPLITTER 1 (Between Left Pane & Preview Pane) -->

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource SplitterBgBrush}" Cursor="SizeWE">

                <GridSplitter.Style>

                    <Style TargetType="GridSplitter">

                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding DataContext.IsOnlineMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                <Setter Property="Visibility" Value="Collapsed"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </GridSplitter.Style>

            </GridSplitter>



            <!-- CENTER SECTION: PREVIEW PANE -->

            <components:SlidePaneView x:Name="PreviewPaneView" Grid.Column="2" DataContext="{Binding PreviewVM}">

                <components:SlidePaneView.Style>

                    <Style TargetType="components:SlidePaneView">

                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding DataContext.IsOnlineMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                <Setter Property="Visibility" Value="Collapsed"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </components:SlidePaneView.Style>

            </components:SlidePaneView>



            <!-- SPLITTER 2 (Between Preview Pane & Live Pane) -->

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource SplitterBgBrush}" Cursor="SizeWE">

                <GridSplitter.Style>

                    <Style TargetType="GridSplitter">

                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding DataContext.IsOnlineMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                <Setter Property="Visibility" Value="Collapsed"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </GridSplitter.Style>

            </GridSplitter>



            <!-- RIGHT SECTION: LIVE PANE -->

            <components:SlidePaneView x:Name="LivePaneView" Grid.Column="4" DataContext="{Binding LiveVM}">

                <components:SlidePaneView.Style>

                    <Style TargetType="components:SlidePaneView">

                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding DataContext.IsOnlineMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                <Setter Property="Visibility" Value="Collapsed"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </components:SlidePaneView.Style>

            </components:SlidePaneView>



            <!-- ONLINE BROWSER VIEW (Full-width across entire window when Online tab is active) -->

            <components:OnlineBrowserView x:Name="MainOnlineBrowserView" Grid.Column="0" Grid.ColumnSpan="5">

                <components:OnlineBrowserView.Style>

                    <Style TargetType="components:OnlineBrowserView">

                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding DataContext.IsOnlineMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                <Setter Property="Visibility" Value="Visible"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </components:OnlineBrowserView.Style>

            </components:OnlineBrowserView>

        </Grid>



        <!-- 4. BOTTOM STATUS BAR (Matching Image 1 & 5) -->

        <StatusBar Grid.Row="3" Background="{DynamicResource StatusBarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,0">

            <StatusBar.ItemsPanel>

                <ItemsPanelTemplate>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                    </Grid>

                </ItemsPanelTemplate>

            </StatusBar.ItemsPanel>



            <!-- Active Selected Item / Reference (e.g. "Genesis 1:1 (KJV)" or "O Come All Ye Faithful - C. Frederick Oakeley; Public Domain") -->

            <StatusBarItem Grid.Column="0">

                <TextBlock Text="{Binding StatusText}" FontSize="11" FontFamily="Tahoma" Foreground="{DynamicResource TextPrimaryBrush}"/>

            </StatusBarItem>



            <!-- Displays / Projector Connection Indicator -->

            <StatusBarItem Grid.Column="1" Margin="0,0,8,0">

                <TextBlock Text="{Binding DisplayStatusText}" FontSize="11" FontFamily="Tahoma" Foreground="#047857"/>

            </StatusBarItem>

        </StatusBar>

    </Grid>

</Window>

